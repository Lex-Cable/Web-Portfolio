# GEMINI_API_KEY: Required for server-side Gemini AI portfolio analysis and drafting.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for sitemap.xml, robots.txt, and canonical metadata.
APP_URL="MY_APP_URL"

# GITHUB_USERNAME: Public GitHub account to synchronize (defaults to Lex-Cable).
GITHUB_USERNAME="Lex-Cable"

# GITHUB_TOKEN: Optional GitHub Personal Access Token (public_repo / read:user scope).
# Enables GitHub GraphQL contribution statistics and higher API rate limits (5,000 req/hr).
GITHUB_TOKEN=

# GITLAB_USERNAME: GitLab profile handle to synchronize (defaults to lex_cab23).
GITLAB_USERNAME="lex_cab23"

# GITLAB_TOKEN: Optional GitLab Personal Access Token (read_api scope).
# Enables listing private/internal member projects matching gitlab.com/dashboard/projects/member.
GITLAB_TOKEN=

# Admin access is hardcoded to the verified allowlisted account in the application and requires TOTP MFA.

# SMTP Email Configuration (Optional: enables real email forwarding from the Contact Form)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CRON_SECRET: Shared secret header (x-cron-secret) for scheduled external sync triggers.
CRON_SECRET=
